<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        package="com.android.settings"
        coreApp="true"
        android:sharedUserId="android.uid.system">

    <application android:name="com.statix.android.settings.StatixSettingsApplication"
            android:icon="@drawable/ic_launcher_settings"
            android:theme="@style/Theme.Settings"
            tools:replace="android:name">

        <uses-library android:name="org.apache.http.legacy" />

        <!-- Smart Pixels -->
        <activity android:name="com.statix.android.settings.StatixSettings$SmartPixelsActivity"
                android:exported="true"
                android:label="@string/smart_pixels_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.android.settings.FRAGMENT_CLASS"
                android:value="com.statix.android.settings.fuelgauge.batterysaver.SmartPixels" />
        </activity>

        <!-- Face enroll -->
        <activity android:theme="@style/SudThemeGlif.Light"
                  android:name="com.statix.android.settings.biometrics.face.FaceEnrollActivityDirector"
                  android:exported="true"
                  android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:theme="@style/SudThemeGlif.Light"
                  android:name="com.statix.android.settings.biometrics.face.FaceEnrollConfirmation"
                  android:exported="true"
                  android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.google.android.settings.action.CONFIRM_FACE_ENROLLMENT"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

	<!-- Phone and bluetooth device battery data -->
	<service android:name="com.statix.android.settings.fuelgauge.batterydata.BatteryDataFetchService"
		 android:permission="android.permission.BIND_JOB_SERVICE"
		 android:exported="false"
		 android:process=":usage_data_loader"/>

	<receiver android:name="com.statix.android.settings.fuelgauge.batterydata.BatteryDataBroadcastReceiver"
		  android:exported="true">
	    <intent-filter>
	        <action android:name="settings.intelligence.battery.action.FETCH_BATTERY_USAGE_DATA"/>
	        <action android:name="settings.intelligence.battery.action.FETCH_BLUETOOTH_BATTERY_DATA"/>
	    </intent-filter>
	</receiver>

        <!-- Clear calling -->
        <activity android:name="com.statix.android.settings.notification.ClearCallingSettingsActivity"
                  android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.settings.notification.CLEAR_CALLING"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data android:value="com.statix.android.settings.notification.ClearCallingSettings"
                       android:name="com.android.settings.FRAGMENT_CLASS"/>
        </activity>

        <!-- Locale Picker -->
        <activity
            android:name="com.google.android.settings.localepicker.SetupSystemLocalePickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask">
            <intent-filter android:priority="1">
                <action android:name="com.google.android.settings.localepicker.LOCALE_REGION_PICKER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity
            android:name="com.google.android.settings.localepicker.SetupRegionAndNumberingSystemActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.android.settings.localepicker.REGIONAND_PICKER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity
            android:name="com.google.android.settings.localepicker.SetupRegionSearchActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.android.settings.localepicker.SETUP_REGION_SEARCH"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity
            android:name="com.google.android.settings.localepicker.RegionSearchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateVisible">
            <intent-filter android:priority="1">
                <action android:name="com.google.android.settings.localepicker.REGION_SEARCH"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                android:name="com.android.settings.FRAGMENT_CLASS"
                android:value="com.google.android.settings.localepicker.RegionSearchFragment"/>
        </activity>

        <receiver
            android:name="com.google.android.settings.localepicker.LocalePickerSetupWizardEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.setupwizard.SETUP_WIZARD_FINISHED"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>
